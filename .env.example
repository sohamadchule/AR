# ---------------------------------------------------------------------------
# AR 3D Product Visualization — environment configuration
# Copy to `.env` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required for database access).
# Local example:   postgresql://postgres:postgres@localhost:5432/ar?schema=public
# Hosted (Neon):   postgresql://<user>:<pass>@<host>/<db>?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ar?schema=public"

# Shared admin password. Anyone with this password can manage products.
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# Storage driver. "local" writes GLBs to the filesystem (dev default).
STORAGE_DRIVER="local"

# Directory for the local storage driver (relative to project root).
LOCAL_STORAGE_DIR=".storage"

# Public base URL (scheme + host, no trailing slash) used when generating the
# QR code target and public /view URL. Leave empty to derive it from the
# incoming request (fine for local dev; set explicitly in production).
# PUBLIC_BASE_URL="https://your-domain.com"

# Maximum accepted GLB upload size in bytes. 0 = no limit (MVP default).
# Set this only if your deployment target caps request size.
MAX_UPLOAD_BYTES="0"
